<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient" android:gravity="center" android:orientation="vertical">

    <TextView android:id="@+id/logo" android:layout_width="104dp" android:layout_height="104dp"
        android:background="@drawable/bg_avatar" android:backgroundTint="@color/white"
        android:gravity="center" android:text="🌸" android:textSize="48sp" />

    <TextView android:id="@+id/appName" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="@string/app_name" android:textColor="@color/white"
        android:textSize="32sp" android:textStyle="bold" />

    <TextView android:id="@+id/tagline" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/tagline"
        android:textColor="#FFF0F5" android:textSize="15sp" />
</LinearLayout>
